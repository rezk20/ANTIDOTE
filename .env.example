# ============================================================
# LIFE OS — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================

# --- Supabase Cloud: DEV project (day-to-day development + E2E) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEV-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key

# Server-only. Used by scripts/seed.ts and scripts/reset-dev.ts ONLY.
# This key bypasses RLS. It must never be imported from app/ or lib/.
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# Optional: set to the PROD project URL so the seed script can refuse
# to run against production without an explicit --prod flag.
# SUPABASE_PROD_URL=https://YOUR-PROD-PROJECT-REF.supabase.co

# --- Owner account (created by `npm run db:seed`) ---
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-strong-password

# --- Phase 14: AI layer (server-only) ---
# AI_PROVIDER_API_KEY=

# --- Phase 15: protects /api/cron/* ---
# CRON_SECRET=
